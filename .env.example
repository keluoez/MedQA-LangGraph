# MedQA-LangGraph Demo 环境配置模板
# 用法：复制本文件为 .env 并填入密钥。mock 演示模式零配置可跑；
# 只有 live 模式（真实调用生成管线）才需要 BIOREASON_API_KEY。

# 生成模型（NVIDIA API 或任意 OpenAI 兼容端点）
BIOREASON_API_KEY=
BIOREASON_BASE_URL=https://integrate.api.nvidia.com/v1
BIOREASON_MODEL=meta/llama-3.2-90b-vision-instruct

# 外部独立评估（可选，仅复现论文对比/消融实验时需要）
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
